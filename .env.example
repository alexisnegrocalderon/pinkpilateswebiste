# Base de datos. En producción, la cadena POOLED de Neon (la que dice "-pooler").
DATABASE_URL=postgresql://usuario:clave@localhost:5432/pinkpilates

# Secretos. Cambiar por valores largos y aleatorios en producción.
SESSION_SECRET=cambiar-por-un-secreto-largo
MOCK_WEBHOOK_SECRET=cambiar-por-un-secreto-largo
CRON_SECRET=cambiar-por-un-secreto-largo

# Pasarela de pago: mock | mercadopago | flow | transbank
PAYMENTS_PROVIDER=mock

# URL pública del sitio, usada para las vueltas desde la pasarela.
APP_URL=http://localhost:3000

# Las fechas de negocio se calculan siempre en America/Santiago,
# nunca con la zona del proceso. Fijar UTC mantiene igual dev y producción.
TZ=UTC
